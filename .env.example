# O'zbek Alifbo Konvertori - Environment Variables
# Bu faylni .env deb nusxalang va o'z qiymatlaringizni kiriting

# Application
VITE_APP_NAME=O'zbek Alifbo Konvertori
VITE_APP_VERSION=1.0.0
VITE_APP_URL=https://uzbconverter.uz

# API (kelajakda backend qo'shilsa)
# VITE_API_URL=https://api.uzbconverter.uz
# VITE_API_KEY=your-api-key-here

# Analytics (ixtiyoriy)
# VITE_ANALYTICS_ID=your-analytics-id

# Error Monitoring (ixtiyoriy)
# VITE_SENTRY_DSN=your-sentry-dsn

# Feature Flags
VITE_ENABLE_ADMIN=true
VITE_ENABLE_STATISTICS=true
VITE_ENABLE_FILE_UPLOAD=true

# Limits
VITE_MAX_FILE_SIZE_MB=5
VITE_MAX_HISTORY_ITEMS=100
VITE_MAX_CUSTOM_WORDS=1000
